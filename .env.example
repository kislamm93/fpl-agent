# The public FPL backend the agent's tools call (server-to-server).
# Local dev: the backend from `fpl-backend/dev-fpl.sh`.
# Deployed:  your Render URL, no trailing slash, e.g. https://fpl-backend-xio6.onrender.com
FPL_BACKEND_URL=http://127.0.0.1:8000

# NOTE: the agent needs NO secrets. ODDS_API_KEY / MONGODB_URI / ADMIN_KEY all
# stay on the backend. FPL_BACKEND_URL is the only config this project needs.
